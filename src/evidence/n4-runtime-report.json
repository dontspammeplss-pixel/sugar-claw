    "inverseTransformReset": false
  },
  "verificationScenarios": {
    "eachPoseCaptured": true,
    "repeatedOpenCloseCycles": {
      "cycles": 8,
      "sequence": [
        "open",
        "closed",
        "open",
        "closed"
      ],
      "snapshotsMatch": true,
      "driftDetected": false
    },
    "interruptedCycle": {
      "sequence": [
        "home",
        "closed@40%",
        "open"
      ],
      "staleGenerationIgnored": true,
      "finalTargetExact": true,
      "driftDetected": false
    },
    "resetFromInterruptedCycle": {
      "explicitBaselineRestored": true,
      "staleAnimatorCannotOverwrite": true,
      "driftDetected": false
    },
    "refreshAndRemount": {
      "freshSceneInstances": true,
      "baselineSnapshotsMatch": true,
      "cumulativeDrift": false
    },
    "deliberateDriftProbe": {
      "namedPivotReported": true,
      "driftThreshold": 0.000001
    }
  },
  "runtimeBoundaries": {
    "physics": "not used",
    "statePromotion": "not used",
    "newDependencies": "none",
