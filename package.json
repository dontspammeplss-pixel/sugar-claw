{
  "name": "claw-machine-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "gate:n1a": "node scripts/gate.mjs n1a",
    "scenario:n1a": "vitest run src/bootstrap.test.ts",
    "scenario:n21": "vitest run src/bootstrap.test.ts",
    "gate:n21": "node scripts/gate.mjs n21",
    "gate:ops": "node scripts/gate-ops.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "8.17.10",
    "@react-three/rapier": "1.5.0",
    "gsap": "3.12.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.168.0",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.20.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.168.0",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.17.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.14",
    "globals": "15.14.0",
    "prettier": "3.9.6",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.0",
    "vite": "5.4.10",
    "vitest": "3.2.7"
  }
}
